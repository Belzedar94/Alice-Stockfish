{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Belzedar94/Alice-Stockfish/schemas/alice-openbench-shadow-receipt-v1.schema.json",
  "$defs": {
    "reference": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    },
    "preset": {
      "additionalProperties": false,
      "properties": {
        "adjudication": {"const": ["800/4", "40/8/10"]},
        "binary_role": {
          "enum": ["windows-bmi2", "windows-avx2", "linux-bmi2", "linux-avx2"]
        },
        "binary_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "configuration": {"$ref": "#/$defs/reference"},
        "invalid_pairs": {"const": 0},
        "inversions": {"const": 0},
        "pairs": {"const": 200}
      },
      "required": [
        "binary_role",
        "binary_sha256",
        "configuration",
        "pairs",
        "inversions",
        "invalid_pairs",
        "adjudication"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "network_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "presets": {
      "additionalProperties": false,
      "properties": {
        "LTC": {"$ref": "#/$defs/preset"},
        "STC": {"$ref": "#/$defs/preset"},
        "VSTC": {"$ref": "#/$defs/preset"}
      },
      "required": ["VSTC", "STC", "LTC"],
      "type": "object"
    },
    "schema": {"const": "alice-openbench-shadow-receipt-v1"},
    "service": {"const": "https://belzedar.duckdns.org"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "status": {"const": "PASS"}
  },
  "required": [
    "schema",
    "service",
    "status",
    "source_commit",
    "network_sha256",
    "presets"
  ],
  "type": "object"
}
