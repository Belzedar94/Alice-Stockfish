{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Belzedar94/Alice-Stockfish/schemas/alice-openbench-shadow-configuration-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "adjudication": {"const": ["800/4", "40/8/10"]},
    "binary_role": {
      "enum": ["windows-bmi2", "windows-avx2", "linux-bmi2", "linux-avx2"]
    },
    "binary_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "book_sha256": {
      "const": "bcd89d9fc3ea81feb95932eb64d6b6f15ad25cc04cdcc9e0440f097cffb8ccf6"
    },
    "book_token": {"const": "ALICE"},
    "engine_options": {
      "additionalProperties": false,
      "properties": {
        "Hash": {"const": "512"},
        "Move Overhead": {"const": "10"},
        "Threads": {"const": "1"}
      },
      "required": ["Threads", "Hash", "Move Overhead"],
      "type": "object"
    },
    "network_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "preset": {"enum": ["VSTC", "STC", "LTC"]},
    "runner_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema": {"const": "alice-openbench-shadow-configuration-v1"},
    "service": {"const": "https://belzedar.duckdns.org"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "timing": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "base_ms": {"const": 2000},
            "increment_ms": {"const": 20}
          },
          "required": ["base_ms", "increment_ms"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_ms": {"const": 10000},
            "increment_ms": {"const": 100}
          },
          "required": ["base_ms", "increment_ms"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_ms": {"const": 30000},
            "increment_ms": {"const": 300}
          },
          "required": ["base_ms", "increment_ms"],
          "type": "object"
        }
      ]
    },
    "worker": {
      "additionalProperties": false,
      "properties": {
        "cpuflags": {"maxItems": 0, "type": "array"},
        "pairing": {"const": "color-swapped-pairs"}
      },
      "required": ["cpuflags", "pairing"],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "service",
    "preset",
    "source_commit",
    "network_sha256",
    "binary_role",
    "binary_sha256",
    "book_token",
    "book_sha256",
    "runner_sha256",
    "engine_options",
    "timing",
    "worker",
    "adjudication"
  ],
  "type": "object"
}
